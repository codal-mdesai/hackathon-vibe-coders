# Required — Sanity project
NEXT_PUBLIC_SANITY_PROJECT_ID=PROJECTID
NEXT_PUBLIC_SANITY_DATASET=DATASETNAME

# Optional — needed for Live Content API / draft mode
SANITY_API_READ_TOKEN=

# Required for DevPanel — Auth (next-auth v5)
AUTH_SECRET=                     # openssl rand -base64 32
AUTH_URL=http://localhost:3000   # base URL of the app

# Required for DevPanel — Transactional email (OTP)
RESEND_API_KEY=                  # from resend.com dashboard
RESEND_FROM_EMAIL=               # verified sender e.g. noreply@yourdomain.com

# Required for DevPanel — Sanity write access
SANITY_API_WRITE_TOKEN=          # Sanity write token for Server Actions

# Required for DevPanel — Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used for share link generation

# Required for DevPanel — Encryption
ENCRYPTION_SALT=                 # static PBKDF2 salt, never expose client-side
